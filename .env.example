# Trading Agent Configuration

# General Settings
APP_NAME=Trading-Agent
APP_ENV=development
LOG_LEVEL=INFO

# Trading Settings
DEFAULT_SYMBOLS=AAPL,GOOGL,MSFT,TSLA
DATA_INTERVAL=1d
LOOKBACK_PERIOD=365

# Strategy Settings
INITIAL_CAPITAL=100000
POSITION_SIZE_PCT=0.1
MAX_POSITIONS=5
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15

# Risk Management
MAX_DAILY_LOSS_PCT=0.03
MAX_PORTFOLIO_RISK_PCT=0.20

# Database
DB_PATH=./data/trading_agent.db

# Monitoring
ENABLE_ALERTS=true
ALERT_EMAIL=your-email@example.com

# Backtest Settings
BACKTEST_START_DATE=2020-01-01
BACKTEST_END_DATE=2024-12-31
